# Supabase (Manglar Vivo Atlántico)
NEXT_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter Multimodal Vision (Gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-3.5-flash-lite

# Despacho de Alertas Urgentes por Correo (Hostinger SMTP con subdominio o Resend)
NEXT_PUBLIC_SITE_URL=https://manglar.fourgsolutions.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=alertas@manglar.fourgsolutions.com
SMTP_PASS=
ALERT_EMAIL_FROM=Alertas Manglar Vivo CRA <alertas@manglar.fourgsolutions.com>
ALERT_URGENT_TO=
RESEND_API_KEY=
ALERT_WEBHOOK_URL=
